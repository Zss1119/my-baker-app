<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 自动备份规则：仅备份 Room 数据库与 DataStore 偏好 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="bake_erp.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bake_erp.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>